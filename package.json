{
  "name": "codecaption",
  "productName": "CodeCaption",
  "version": "2.0.0",
  "description": "Puts a unique caption with your referral code on each video and uses it as the file name and title.",
  "author": "CodeWithRoni",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "captions": "node scripts/make-captions.js",
    "dist": "electron-builder --win --publish never",
    "standalone": "node scripts/build-standalone.js"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.codewithroni.codecaption",
    "productName": "CodeCaption",
    "files": ["main.js", "preload.js", "app/**/*"],
    "directories": { "output": "dist", "buildResources": "build" },
    "win": {
      "icon": "build/icon.png",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "CodeCaption-Setup-${version}.${ext}"
    },
    "portable": { "artifactName": "CodeCaption-Portable-${version}.${ext}" }
  }
}
